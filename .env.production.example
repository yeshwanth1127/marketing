# Copy to .env on the server (/srv/apps/marketing/.env). Never commit .env.

POSTGRES_PASSWORD=change-me-long-random
MARKETING_HOST_PORT=8108
EXORA_PUBLIC_ORIGIN=https://marketing.exora.solutions
EXORA_INITIAL_PASSWORD=change-after-first-login

# Meta Marketing API (App Dashboard → Settings → Basic)
META_APP_ID=1634505404780640
META_APP_SECRET=   # App Dashboard → Settings → Basic → Show
META_API_VERSION=v21.0
META_REDIRECT_URI=https://marketing.exora.solutions/api/auth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=   # same string as Meta → Webhooks → Verify token
EXORA_TOKEN_KEY=   # openssl rand -hex 32

# Optional: assistant routing (OpenRouter)
# OPENROUTER_API_KEY=
