DATABASE_URL=postgresql://exora@127.0.0.1:55439/exora_marketing
PORT=3100
# Required by Docker Compose. Replace with a unique, long random value.
POSTGRES_PASSWORD=replace-with-a-long-random-value
# Claude runs through the logged-in Claude Code CLI (Settings > Connect Claude). No API key is used.
# OpenRouter routes each assistant turn and answers talk questions. Paste the key in .env.local.
# EXORA_ROUTER_PROVIDER=claude
# EXORA_ROUTER_MODEL=haiku
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_TALK_MODEL=openai/gpt-4o-mini
# Jev is optional. Used only when OPENROUTER_API_KEY is empty.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# EXORA_TALK_MODEL=haiku
# EXORA_PYTHON=/path/to/python  (default: .local/pyenv/bin/python from npm run setup:python)
# Draft speed. Strategy defaults to compact output with low effort on stages 1-3 and medium on the growth plan.
# EXORA_STRATEGY_DEPTH=full      # restore long-form strategy text (slower, uses more of your Claude allowance)
# EXORA_STRATEGY_MODEL=haiku     # faster again, lower quality. Default: the Claude CLI default model
# EXORA_STRATEGY_EFFORT=low      # low | medium | high | xhigh | max, for every strategy stage
# EXORA_DRAFT_MODEL=             # model for all other drafts (content, hooks, plans). Default: CLI default
# EXORA_DRAFT_EFFORT=            # effort for all other drafts
# EXORA_REVISE_ATTEMPTS=2        # how often a caption that fails its lint is sent back to Claude to fix (1-3)
# EXORA_REVISE_MODEL=            # model for that edit. Default: the Claude CLI default
# Meta Marketing API. Put real values in .env.local only — never in frontend code or git.
# META_APP_ID=
# META_APP_SECRET=
# META_API_VERSION=v21.0
# META_REDIRECT_URI=http://127.0.0.1:3100/api/auth/meta/callback
# EXORA_TOKEN_KEY=   # 64 hex chars; encrypts client tokens at rest
# META_WEBHOOK_VERIFY_TOKEN=
# EXORA_PUBLIC_ORIGIN=https://marketing.exora.solutions
# EXORA_ALLOWED_ORIGINS=

# Video editor and pipeline (core/video). Typographic videos render locally from a VideoDesign document, no model call.
# EXORA_VIDEO_COMPOSER=            # "claude-film" brings back the old Claude-written HyperFrames film for every video (slow, model-heavy)
# EXORA_VIDEO_QUALITY=looks        # HyperFrames quality for beat renders: draft, looks, delivery
# EXORA_RENDER_CHROMES=            # cap on parallel Chrome render workers. Default: from CPUs and the container memory limit
# WORKER_MEM_LIMIT=2048m           # Docker memory limit of the worker (compose.yaml). More memory = more beats rendered in parallel
# EXORA_EDIT_MODEL=haiku           # small model that turns "make polo italic red" into a JSON patch
# EXORA_VOICE_RELAY_MODEL=haiku    # small model that relays the ElevenLabs MCP call when ELEVENLABS_API_KEY is not set
# ELEVENLABS_API_KEY=              # direct text-to-speech (no model tokens at all). Optional
# Generated footage layers only (never used for typographic videos): Creative Claw over MCP, server-side.
# EXORA_CREATIVE_CLAW=0            # 1 to allow generated footage layers
# CREATIVE_CLAW_TOKEN=             # bearer token for https://app.creativeclaw.co/mcp. Never commit it
# CREATIVE_CLAW_MCP_URL=https://app.creativeclaw.co/mcp
# CREATIVE_CLAW_TIMEOUT_MS=60000
