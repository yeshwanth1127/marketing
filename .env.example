DATABASE_URL=postgresql://exora@127.0.0.1:55439/exora_marketing
PORT=3100
# Claude runs through the logged-in Claude Code CLI (Settings > Connect Claude). No API key is used.
# OpenRouter routes each assistant turn and answers talk questions. Paste the key in .env.local.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_TALK_MODEL=openai/gpt-4o-mini
# Jev is optional. Used only when OPENROUTER_API_KEY is empty.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# EXORA_TALK_MODEL=haiku
# EXORA_PYTHON=/path/to/python  (default: .local/pyenv/bin/python from npm run setup:python)
# Meta Marketing API. Put real values in .env.local only — never in frontend code or git.
# META_APP_ID=
# META_APP_SECRET=
# META_API_VERSION=v21.0
# META_REDIRECT_URI=http://127.0.0.1:3100/api/auth/meta/callback
# EXORA_TOKEN_KEY=   # 64 hex chars; encrypts client tokens at rest
# META_WEBHOOK_VERIFY_TOKEN=
# EXORA_PUBLIC_ORIGIN=https://marketing.exora.solutions
# EXORA_ALLOWED_ORIGINS=
