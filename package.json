{
  "name": "exora-marketing-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev web --hostname 127.0.0.1 --port 3100",
    "build": "next build web",
    "start": "next start web --hostname 127.0.0.1 --port 3100",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "worker": "node --env-file-if-exists=.env.local scripts/worker.mjs",
    "test": "node --env-file-if-exists=.env.local scripts/test.mjs",
    "local": "bash scripts/local.sh",
    "agent:smoke": "node --env-file-if-exists=.env.local scripts/agent-smoke.mjs",
    "setup:python": "bash scripts/setup-python.sh",
    "vendor:sync": "bash scripts/vendor-sync.sh",
    "design:smoke": "node --env-file-if-exists=.env.local scripts/design-smoke.mjs",
    "video:smoke": "node --env-file-if-exists=.env.local scripts/design-smoke.mjs --video"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "bcryptjs": "^3.0.2",
    "ffprobe-static": "^3.1.0",
    "gsap": "^3.15.0",
    "hyperframes": "^0.8.226",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.55.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3"
  }
}
